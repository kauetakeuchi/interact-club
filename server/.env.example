DATABASE_URL="mysql://root:@localhost:3306/interact_club"
JWT_SECRET="troque-por-um-segredo-forte"
PORT=3001
APP_URL="http://localhost:3001"

# Obrigatório para confirmar o email de novos cadastros.
# Opções: gmail, brevo, resend, hostinger ou smtp.
EMAIL_PROVIDER="resend"
SMTP_USER="usuario-smtp"
SMTP_PASS="senha-smtp"
SMTP_FROM="Interact Club <contato@exemplo.org>"

# Somente para EMAIL_PROVIDER="smtp" (ou para substituir um preset):
SMTP_HOST=""
SMTP_PORT=
SMTP_SECURE=

# Opcional: quando preenchido, os uploads usam o Cloudinary.
# Sem estas variáveis, as imagens continuam salvas localmente em public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
