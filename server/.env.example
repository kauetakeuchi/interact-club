DATABASE_URL="mysql://root:@localhost:3306/interact_club"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
PORT=3001
# URL pública do site. Com https, o cookie de sessão passa a usar Secure automaticamente.
APP_URL="http://localhost:3001"

# Fuso usado pelo Node para interpretar/formatar datas do banco.
TZ="America/Sao_Paulo"

# Defina 1 quando o app estiver atrás de nginx/Cloudflare (proxy reverso).
# Sem isso, o Express vê o IP do proxy e o rate limit fica ineficaz.
TRUST_PROXY=""

# Obrigatório para confirmar o email de novos cadastros e redefinir senhas.
# Opções: gmail, brevo, resend, hostinger ou smtp.
EMAIL_PROVIDER="resend"
SMTP_USER="usuario-smtp"
SMTP_PASS="senha-smtp"
SMTP_FROM="Interact Club <contato@exemplo.org>"

# Somente para EMAIL_PROVIDER="smtp" (ou para substituir um preset):
SMTP_HOST=""
SMTP_PORT=
SMTP_SECURE=

# Opcional: quando preenchido, os uploads usam o Cloudinary.
# Sem estas variáveis, as imagens continuam salvas localmente em public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
